# Postgres. En desarrollo local: docker compose up -d (ver README).
# En producción (Neon): usa la connection string "pooled" (host con -pooler).
DATABASE_URL="postgresql://formeco:formeco_dev_pw@localhost:5433/form_eco?schema=public"

# Usada solo para migraciones (prisma migrate deploy). En local, igual a
# DATABASE_URL. En Neon: la connection string "directa" (sin -pooler).
DIRECT_URL="postgresql://formeco:formeco_dev_pw@localhost:5433/form_eco?schema=public"

# Vercel Blob (almacenamiento de fotos). Generar con `vercel blob store add`
# o desde el dashboard de Vercel. Si se deja vacío, en desarrollo local las
# fotos se guardan en /public/uploads como fallback (ver src/app/api/photos/upload/route.ts).
BLOB_READ_WRITE_TOKEN=""
